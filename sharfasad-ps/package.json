{
  "name": "sharfasad-ps",
  "private": true,
  "scripts": {
    "studio": "remotion studio",
    "draft": "remotion render Main out/draft.mp4 --scale=0.5 --crf=28",
    "render": "remotion render Main out/silent.mp4 --muted",
    "sfx": "python3 -I sfx/build.py \"$SFX_DIR\" \"$TICK_MP3\" \"$RISER_MP3\" \"$NEWS_BED_MP3\"",
    "mux": "ffmpeg -loglevel error -y -i out/silent.mp4 -i public/final.wav -map 0:v -map 1:a -c:v copy -c:a aac -b:a 256k -movflags +faststart -shortest out/sharfasad-ps.mp4",
    "build": "npm run sfx && npm run render && npm run mux",
    "sheet": "node scripts/sheet.mjs",
    "wave": "node scripts/wave.mjs",
    "sims": "node ../claude-motion/sims/build.mjs",
    "stills": "node scripts/stills.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.529",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.529",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@remotion/bundler": "4.0.529",
    "@remotion/renderer": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}