تړونو", 356.301, 356.869, 20, 46], ["تکیه", 356.814, 357.359, 20, 46], ["هغه", 357.38, 357.956, 20, 46], ["خنډونه", 357.932, 358.446, 20, 46], ["دي", 358.365, 358.605, 20, 46], ["چې", 358.58, 358.882, 20, 46], ["د", 358.925, 359.055, 20, 46], ["دوی", 359.56, 359.89, 20, 46], ["د", 359.85, 359.98, 20, 46], ["سیاسي", 360.014, 360.496, 20, 46], ["ادعاوو", 360.635, 360.815, 20, 46], ["اعتبار", 360.754, 361.327, 20, 46], ["یې", 361.286, 361.523, 20, 46], ["تر", 361.5, 361.97, 20, 46], ["پوښتنې", 361.998, 362.672, 20, 46], ["لاندې", 362.644, 363.249, 20, 46], ["راوستی", 363.27, 364.151, 20, 46], ["دی.", 364.115, 364.442, 20, 46], ["د", 364.51, 364.64, 21, 47], ["افغانستان", 364.919, 365.842, 21, 47], ["برخلیک", 365.795, 366.375, 21, 47], ["د", 366.475, 366.605, 21, 47], ["هغو", 366.845, 367.235, 21, 47], ["څېرو", 367.258, 367.68, 21, 47], ["له", 367.603, 367.77, 21, 47], ["لوري", 367.678, 368.092, 21, 47], ["نه", 368.074, 368.268, 21, 47], ["ټاکل", 368.202, 368.716, 21, 47], ["کېږي", 368.685, 369.025, 21, 47], ["چې", 368.99, 369.302, 21, 47], ["د", 369.355, 369.485, 21, 47], ["تېرې", 369.945, 370.285, 21, 47], ["واکمنۍ", 370.246, 370.824, 21, 47], ["د", 370.795, 370.925, 21, 47], ["کړنو", 370.965, 371.305, 21, 47], ["حساب", 371.272, 371.778, 21, 47], ["نه", 371.79, 372.0, 21, 47], ["شي", 371.95, 372.24, 21, 47], ["ورکولای،", 372.237, 372.833, 21, 47], ["په", 372.91, 373.2, 21, 47], ["اوسني", 373.23, 373.847, 21, 47], ["وخت", 373.813, 374.117, 21, 47], ["کې", 374.065, 374.265, 21, 47], ["ګډ", 374.223, 374.567, 21, 47], ["سیاسي", 374.542, 375.088, 21, 47], ["دریځ", 375.045, 375.413, 21, 47], ["نه", 375.36, 375.54, 21, 47], ["لري", 375.46, 375.79, 21, 47], ["او", 375.885, 376.365, 21, 47], ["د", 376.465, 376.595, 21, 47], ["خپل", 376.575, 376.925, 21, 47], ["راتلونکي", 376.882, 377.45, 21, 47], ["لپاره", 377.398, 377.922, 21, 47], ["د", 377.899, 378.029, 21, 47], ["بهرنیو", 378.036, 379.11, 21, 47], ["قدرتونو", 379.072, 379.71, 21, 47], ["ملاتړ", 379.67, 380.155, 21, 47], ["ته", 380.14, 380.562, 21, 47], ["سترګې", 380.725, 381.535, 21, 47], ["په", 381.6, 381.84, 21, 47], ["لار", 381.82, 382.39, 21, 47], ["دي.", 382.44, 382.71, 21, 47]], "paras": [{"id": 0, "text": "له اسلام آباده تر مادریده؛ د مخالفینو د بې‌پایلې ناستو دوام", "a": 0.04, "b": 5.838}, {"id": 1, "text": "۱. د غونډو تکراري لړۍ", "a": 5.788, "b": 9.472}, {"id": 2, "text": "د اسلام آباد له لومړي پړاو او لندن له دویم پړاو وروسته، دا ځل د افغان حکومت یو شمېر مخالفې څېرې د اسپانیا په مادرید کې راټولې شوې وې. دا پرله‌پسې ناستې د هغو ډلو د بیا راټولولو هڅې دي چې له اوږدې مودې راهیسې له خپلمنځي اختلافاتو، سیاسي بې‌باورۍ او د ګډې اجنډا له نشتون سره مخ دي.", "a": 9.58, "b": 32.217}, {"id": 3, "text": "۲. محدود ګډونوال، تکراري څېرې", "a": 32.167, "b": 37.19}, {"id": 4, "text": "په غونډه کې د پخوانیو سیاسي څېرو یو شمېر خپلوانو، پخوانیو پارلماني استازو، د رسنیو او مدني فعالیتونو ځینو مخکینیو غړو او د بېلابېلو مخالفو ډلو استازو ګډون کړی وو؛ هغه څېرې چې د خپل سیاسي نفوذ او ولسي ملاتړ د ثابتولو لپاره له جدي ننګونو سره مخ دي. د دوی تکراري راټولېدل د کومې پراخې ملي اجماع پر ځای د محدودو سیاسي کړیو د بیا فعالولو هڅې ښکاري.", "a": 37.835, "b": 69.5}, {"id": 5, "text": "۳. د بهرنیو ملاتړونو په تمه", "a": 69.45, "b": 74.625}, {"id": 6, "text": "د اسلام آباد، لندن او مادرید د ناستو پرله‌پسې تکرار دا پوښتنه راپورته کوي چې دغه جریانونه ولې د خپلو سیاسي هڅو لپاره بهرنیو ناستو او ملاتړونو ته اړتیا لري؟ په ځانګړي ډول، د پاکستان د پوځي رژیم له ملاتړ سره د دوی اړیکې او راټولېدل د دوی د سیاسي خپلواکۍ په اړه جدي پوښتنې راپورته کوي.", "a": 74.645, "b": 100.605}, {"id": 7, "text": "۴. د تېرې واکمنۍ ترخې تجربې", "a": 100.555, "b": 103.66}, {"id": 8, "text": "د دغو مخالفو څېرو یوه لویه ستونزه د دوی ترمنځ؛ پخوانی سیاسي فعالیت، سابقه، کړنې او د واکمنۍ پر مهال یې پرېکړې، هغه میراث دی چې اوس یې هم ځان سره لري. د پخوانۍ واکمنۍ پر مهال د فساد، اداري بې‌نظمۍ، سیاسي انحصار، خپل‌سرو پرېکړو، د واک پر سر سیالیو او د شخصي ګټو د خوندي کولو په اړه پراخ انتقادونه موجود وو. اوس هماغه څېرې هڅه کوي د سیاسي بدیل او راتلونکي نظام په نوم ځانونه وړاندې کړي، خو لا یې د تېرې دورې د ناکامیو او پوښتنو قانع کوونکی ځواب نه دی وړاندې کړی.", "a": 103.845, "b": 148.827}, {"id": 9, "text": "۵. خپلمنځي اختلافات او د مشرتابه بحران", "a": 148.777, "b": 152.88}, {"id": 10, "text": "د مخالفو ډلو ترمنځ د مشرتابه پر سر سیالۍ، د شخصي ګټو ټکر، د متقابل باور نشتون، د ډلو وېش او د نفوذ پر سر شخړې د دوی د سیاسي فعالیتونو مهمې ځانګړنې پاتې شوې دي. د دوی ترمنځ هره ډله ځان د مشرتابه مستحق ګڼي، خو د یوه ګډ سیاسي دریځ او منل شوي رهبرۍ پر جوړولو نه دي توانېدلي. له همدې امله، د دوی غونډې د اختلافاتو د حل پر ځای ډېری وخت د هماغو اختلافاتو د تکرار صحنې ګرځي.", "a": 154.14, "b": 192.461}, {"id": 11, "text": "۶. له افغانستانه تر بهرنیو دروازو", "a": 192.411, "b": 194.262}, {"id": 12, "text": "هغه څېرې چې پخوا یې د واک او سیاسي نفوذ ادعاوې کولې، اوس له افغانستانه بهر په بېلابېلو هېوادونو کې مېشتې دي او د خپلو سیاسي موخو د تعقیب لپاره د بهرنیو لورو ملاتړ لټوي. د دوی سیاسي فعالیتونه تر ډېره په غونډو، اعلامیو، مرکو او ټولنیزو رسنیو پورې محدود پاتې شوي او د هېواد دننه د پراخ ولسي ملاتړ د ترلاسه کولو لپاره یې کوم څرګند عملي بدیل نه دی وړاندې کړی او نه به یې وړاندې کړي.", "a": 194.306, "b": 227.046}, {"id": 13, "text": "۷. د پاکستان په غېږ کې د سیاسي پناه لټول", "a": 226.996, "b": 232.038}, {"id": 14, "text": "تر ټولو د پام وړ بدلون دا دی چې د افغانستان پر وړاندې د پاکستان د پوځي رژیم د سیاستونو او فشارونو په اړه د افغانانو له حساسیت سره سره، یو شمېر مخالفې څېرې د همدې رژیم په سیاسي چاپېریال او ملاتړ پورې تړلې ناستې ترسره کوي. دا وضعیت د دوی د دریځ او عملي سیاسي تګلارې ترمنځ ښکاره تناقض رامنځته کوي. هغه څوک چې د افغانستان د راتلونکي برخلیک د ټاکلو ادعا کوي، باید لومړی د خپلو بهرنیو اړیکو او سیاسي خپلواکۍ په اړه ولس ته روښانه ځواب ولري.", "a": 232.918, "b": 270.281}, {"id": 15, "text": "۸. د ولسي مشروعیت نشتون", "a": 270.231, "b": 274.52}, {"id": 16, "text": "د دغو مخالفو څېرو اساسي ستونزه یوازې د غونډو د جوړولو او د ګډونوالو د راټولولو موضوع نه ده؛ بلکې د ولسي ملاتړ، ګډې اجنډا، متقابل باور او منل شوي سیاسي مشرتابه نشتون دی. د څو محدودو سیاسي څېرو راټولېدل د افغانستان د خلکو استازیتوب نه شي کولای. ولسي مشروعیت د بهرنیو ناچیزه غونډو، ناچیزه سیاسي معاملاتو او تکراري ګډو وډو اعلامیو له لارې نه ترلاسه کېږي.", "a": 274.735, "b": 307.895}, {"id": 17, "text": "۹. غونډې ډېرې، لاسته راوړنې کمې", "a": 307.845, "b": 312.963}, {"id": 18, "text": "د اسلام آباد، لندن او مادرید ترمنځ د ناستو ځایونه بدلېږي، خو د مخالفینو خپلمنځي اختلافات، د ګډې اجنډا نشتون، د تېرې واکمنۍ میراث او د ولسي ملاتړ کمزورتیا لا هم پر خپل ځای پاتې دي.", "a": 313.24, "b": 329.22}, {"id": 19, "text": "د داسې پاشلو غونډو جوړول سیاسي ځواک نه شمېرل کېږي، ګډې وډې اعلامیې ولسي مشروعیت نه شي رامنځته کولای او بهرني احتمالي ملاتړونه د افغانانو باور نه شي ترلاسه کولای.", "a": 329.42, "b": 344.09}, {"id": 20, "text": "له اسلام آباده تر لندن او مادریده؛ د مخالفینو د غونډو لړۍ به ښايي دوام ولري، خو د دوی ترمنځ اختلافات، سیاسي بې‌باوري او پر بهرنیو ملاتړونو تکیه هغه خنډونه دي چې د دوی د سیاسي ادعاوو اعتبار یې تر پوښتنې لاندې راوستی دی.", "a": 344.079, "b": 364.442}, {"id": 21, "text": "د افغانستان برخلیک د هغو څېرو له لوري نه ټاکل کېږي چې د تېرې واکمنۍ د کړنو حساب نه شي ورکولای، په اوسني وخت کې ګډ سیاسي دریځ نه لري او د خپل راتلونکي لپاره د بهرنیو قدرتونو ملاتړ ته سترګې په لار دي.", "a": 364.51, "b": 382.71}]}